# Copy this file to paths.env and edit only the values below.
# Use absolute paths. Quoting permits spaces in directory names.

# Original extracted AGHRI dataset.
AGHRI_SOURCE_ROOT="/absolute/path/to/extracted/AGHRI"

# Parent directory for a new AGHRI-to-nuScenes-style conversion run.
CONVERSION_RUN_ROOT="/absolute/path/to/new/aghri_nuscenes_run"

# Converted AGHRI dataset root produced by the conversion.
AGHRI_DATASET_ROOT="$CONVERSION_RUN_ROOT/AGHRI_nuScenes_camera_lidar_full"

# Temporary/work directory used during conversion.
CONVERSION_WORK_ROOT="$CONVERSION_RUN_ROOT/work"

# Output root for generated PKL variants.
AGHRI_PKL_OUTPUT_ROOT="/absolute/path/to/new/aghri_pkls"

# Optional compatibility setting for an older local conversion that stores
# synchronization metadata outside metadata/synchronization/.
# Leave unset for the published AGHRI-to-nuScenes-style layout.
# AGHRI_SYNCHRONIZATION_DIR="/absolute/path/to/synchronization"

# Change this only if the required packages are installed in another interpreter.
PYTHON_EXECUTABLE="python3"
